# EJEMPLO de cómo se ve el archivo secreto (secrets.toml). NO tiene datos reales.
# No lo copies a mano: corre  python3 crear_secretos.py  y se crea solo.
# Mientras NO exista secrets.toml, la app funciona en MODO PRUEBA LOCAL.

[basedatos]
host = "aws-0-sa-east-1.pooler.supabase.com"
puerto = 5432
usuario = "postgres.abcdefghijklmnop"
contrasena = "LA-CONTRASEÑA-DE-LA-BASE-DE-DATOS"
nombre = "postgres"

[usuarios.gabriel]
nombre = "Gabriel"
hash = "pbkdf2_sha256$200000$...$..."
rol = "admin"
